# Copy to .env: cp .env.example .env
#
# Docker (from repo root): docker compose up --build
# Host Node against Compose Postgres: docker compose up -d postgres
#
# DATABASE_URL below is for host Node. Compose overrides it to the
# postgres service hostname when the API runs in Docker.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_intelligence

# Optional — NestJS listen port (default: 3000)
PORT=3000

JWT_ACCESS_SECRET=214d5f6754b7af28cca7e470e2186dafa21bcca5e52fc5225acaa53ec2b78ff91474a4e36c7f5c8e350e8f3cc15935e3b46b41b40be70960edafcb5a0f2cc524
JWT_REFRESH_SECRET=cdd8651e62055b465d21fbe4fc29b2a31744013b9e5bc9496a5dcb9a6afa0d8d33b5f343728410d0efe069914b3ce5409056d4d1619704976f5298e998e8f307

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional — cookie Secure flag. Unset = true when NODE_ENV=production, otherwise false.
# AUTH_COOKIE_SECURE=false

# Optional — cookie SameSite. Use "none" (with Secure) when web and API are on different hosts (e.g. Railway).
# AUTH_COOKIE_SAMESITE=lax

# Browser origin for the Vue app (credentials / CORS)
CORS_ORIGIN=http://localhost:5173

# Google OAuth (authorization code / OIDC). Scopes: openid email profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:5173/auth/callback
GOOGLE_OAUTH_LINK_URL=http://localhost:5173/auth/link


# Auth rate limit (register/login): 5 requests per 60s per IP
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000