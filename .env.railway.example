# Railway production environment (API service)
#
# Create a Railway project with:
#   1. Postgres plugin
#   2. Service "api"  — Dockerfile target `api` (use railway.api.json)
#   3. Service "web"  — Dockerfile target `web` (use railway.web.json)
#
# Link Postgres → api so DATABASE_URL is injected automatically.
# Set VITE_API_URL as a *build* argument on the web service to your public API URL
# (e.g. https://api-production-xxxx.up.railway.app/api/v1).

NODE_ENV=production
PORT=3000

# Injected by Railway Postgres when services are linked:
# DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cross-origin cookies (web and api are different *.up.railway.app hosts)
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# Public Vue origin (Railway web URL, no trailing slash)
CORS_ORIGIN=https://YOUR_WEB_SERVICE.up.railway.app

# Google OAuth — add these URLs in Google Cloud Console too
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_API_SERVICE.up.railway.app/api/v1/auth/google/callback
GOOGLE_OAUTH_SUCCESS_URL=https://YOUR_WEB_SERVICE.up.railway.app/auth/callback
GOOGLE_OAUTH_LINK_URL=https://YOUR_WEB_SERVICE.up.railway.app/auth/link

AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000
