# Railway production / dev environment (API service)
#
# Web uses same-origin /api/v1 → nginx proxies to api.railway.internal.
# Set the API service Dockerfile to Dockerfile.api (not the root Dockerfile).

NODE_ENV=production
PORT=8080

# Link Postgres → api:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Same-origin via web proxy → lax is fine. Use none if calling API domain directly from the browser.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Public Vue origin
CORS_ORIGIN=https://web-dev-98e7.up.railway.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://web-dev-98e7.up.railway.app/api/v1/auth/google/callback
GOOGLE_OAUTH_SUCCESS_URL=https://web-dev-98e7.up.railway.app/auth/callback
GOOGLE_OAUTH_LINK_URL=https://web-dev-98e7.up.railway.app/auth/link

AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000
